# Единственный .env монорепо: его читают и docker compose (подстановка ${VAR}),
# и бэкенд при локальном запуске (apps/backend/src/app.module.ts), и Prisma CLI
# (apps/backend/prisma.config.ts). Пер-приложенческих .env нет.
#
# Внутри контейнеров файл не виден: там значения приходят из environment в
# docker-compose.yml — они же перекрывают адреса, которые снаружи выглядят иначе
# (DATABASE_URL, BACKEND_URL).

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=saas_control
# порт на хосте: 5432 занят локальным Postgres, поэтому 5433
POSTGRES_PORT=5433

# --- Prisma ---
# адрес БД с хоста; в контейнерах compose подменяет его на postgres:5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/saas_control?schema=public"

# --- Порты приложений на хосте ---
BACKEND_PORT=3000
FRONTEND_PORT=3001

# --- Авторизация ---
# обязателен: им подписывается сессионный JWT, в проде — свой длинный секрет
JWT_SECRET=dev-only-secret-change-me
# срок жизни сессии, секунды (7 дней)
SESSION_TTL_SECONDS=604800
# secure у куки включается сам при NODE_ENV=production; здесь http, поэтому false
COOKIE_SECURE=false

# --- Почта ---
# адрес фронтенда: из него собирается ссылка подтверждения почты
APP_URL=http://localhost:3001
# без SMTP_URL письма не уходят, а ссылка пишется в лог бэкенда
# SMTP_URL=smtp://user:password@smtp.example.com:587
MAIL_FROM=no-reply@saas-control.local

# --- Фронтенд ---
# адрес бэкенда для серверной части Next и для proxy /api/*;
# значение по умолчанию в коде такое же, переменная нужна для другого адреса
# BACKEND_URL=http://localhost:3000

# --- saas_bridge (развёртывание сайтов на бенче) ---
# без этих трёх переменных сайт только записывается в базу кабинета,
# bench new-site не вызывается — обычный режим разработки
# BRIDGE_URL=https://control.example.com
# ключи System Manager с управляющего сайта: API Key и API Secret
# BRIDGE_API_KEY=
# BRIDGE_API_SECRET=
