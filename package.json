{
  "name": "saas-control",
  "version": "0.0.1",
  "private": true,
  "description": "SaaS Control monorepo (backend + frontend)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm:backend:dev\" \"npm:frontend:dev\"",
    "build": "npm run backend:build && npm run frontend:build",
    "test": "npm run backend:test && npm run frontend:test",
    "lint": "npm run lint --workspaces --if-present",
    "backend": "npm run --workspace @saas-control/backend",
    "backend:dev": "npm run start:dev --workspace @saas-control/backend",
    "backend:build": "npm run build --workspace @saas-control/backend",
    "backend:test": "npm run test --workspace @saas-control/backend",
    "frontend": "npm run --workspace @saas-control/frontend",
    "frontend:dev": "npm run dev --workspace @saas-control/frontend",
    "frontend:build": "npm run build --workspace @saas-control/frontend",
    "frontend:test": "npm run test --workspace @saas-control/frontend",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate:docker": "docker compose --profile tools run --rm migrate",
    "docker:build": "docker compose --profile app build",
    "docker:dev:up": "docker compose --profile dev up -d --build",
    "docker:dev:down": "docker compose --profile dev down",
    "docker:dev:logs": "docker compose --profile dev logs -f",
    "docker:dev:migrate": "docker compose --profile dev exec backend-dev npx prisma migrate deploy",
    "docker:up": "docker compose --profile app up -d --build",
    "docker:down": "docker compose --profile app down",
    "docker:logs": "docker compose --profile app logs -f"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
